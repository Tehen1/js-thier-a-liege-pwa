---
// Section Jeux du Thier (extrait de ClubMarkup.tsx)
// Les moteurs sont chargés depuis /app.js par import() différé.
// Ce composant Astro reste uniquement déclaratif et sans script classique inline.
---
<section id="jeu" class="sec game">
  <header class="sec-head">
    <span class="num">V</span>
    <h2>Les jeux du Thier</h2>
  </header>

  <p class="game-lede">Deux mini-jeux aux couleurs du club. Battez le record, entrez dans le top 3, défiez les copains de l'équipe.</p>

  <div class="game-tabs" role="tablist" aria-label="Choisir un jeu">
    <button class="gtab" type="button" data-mode="runner" role="tab" aria-controls="paneRunner" aria-selected="true">
      <span class="gtab-ico" aria-hidden="true">⚡</span>
      <span class="gtab-txt"><b>Runner</b><small>Dribble, saute, tire</small></span>
      <span class="gtab-rec">Record<em id="recRunner">—</em></span>
    </button>
    <button class="gtab" type="button" data-mode="penalty" role="tab" aria-controls="panePenalty" aria-selected="false">
      <span class="gtab-ico" aria-hidden="true">🥅</span>
      <span class="gtab-txt"><b>Tirs au but</b><small>5 tirs · 3 niveaux</small></span>
      <span class="gtab-rec">Record<em id="recPenalty">—</em></span>
    </button>
  </div>

  <div class="game-layout">
    <div class="game-pane" id="paneRunner" role="tabpanel" data-pane="runner">
      <ul class="rules">
        <li class="r-bad"><i>−</i><b>Tacle</b><span>Sautez par-dessus. Touché : une vie en moins.</span></li>
        <li class="r-good"><i>+</i><b>Ballon</b><span>Tirez dedans : 50 pts × niveau.</span></li>
        <li class="r-gold"><i>★</i><b>Ballon doré</b><span>Rare : 150 pts × niveau.</span></li>
        <li class="r-lvl"><i>↑</i><b>Niveau</b><span>Tous les 220 m : plus vite, plus de tacles.</span></li>
      </ul>
      <div class="game-shell">
        <div class="game-hud">
          <div class="lives" id="rLives" aria-label="Vies"></div>
          <div class="score" aria-live="polite"><span id="rScore">0</span><small>points</small></div>
          <div class="best">Niveau <b id="rLevel">1</b></div>
        </div>
        <div class="prog" aria-label="Progression vers le niveau suivant"><i id="rProg"></i></div>
        <div class="game-wrap runner-wrap" id="runWrap">
          <canvas id="runner" role="img" aria-label="Mini-jeu runner : le joueur de la JS dribble, saute les tacles et tire dans les ballons"></canvas>
          <div class="game-overlay" id="rOverlay">
            <img src="/images/crest.svg" alt="" class="ov-crest" width="72" height="84" loading="lazy" decoding="async" />
            <p class="ov-title" id="rTitle">Coup d'envoi</p>
            <div class="ov-sub" id="rSub">
              <div class="keys">
                <span><kbd>Espace</kbd><kbd>↑</kbd> sauter</span>
                <span><kbd>X</kbd><kbd>→</kbd> tirer</span>
              </div>
              <small class="touch-hint">Sur téléphone : touchez à gauche pour sauter, à droite pour tirer.</small>
            </div>
            <form class="pseudo" id="rForm" hidden>
              <label for="rName">Nouveau top 3 ! Votre pseudo :</label>
              <div><input id="rName" maxlength="12" autocomplete="off" placeholder="ex. Olive10" required /><button class="btn btn-yellow" type="submit">Enregistrer</button></div>
              <button type="button" class="skip" data-skip="r">Passer</button>
            </form>
            <button type="button" class="btn btn-yellow" id="rStart">Jouer</button>
          </div>
        </div>
        <div class="pad">
          <button type="button" id="rJump" class="pad-btn">⤒ Saut</button>
          <button type="button" id="rShoot" class="pad-btn pad-shoot">Tir ⚽</button>
        </div>
      </div>
    </div>

    <div class="game-pane" id="panePenalty" role="tabpanel" data-pane="penalty" hidden>
      <ul class="rules rules-3">
        <li class="r-good"><i>◎</i><b>Visez</b><span>Déplacez la cible dans le but.</span></li>
        <li class="r-gold"><i>⚽</i><b>Frappez</b><span>Cliquez ou touchez pour tirer.</span></li>
        <li class="r-bad"><i>!</i><b>Risque</b><span>Près des poteaux : dur à arrêter, mais facile à rater.</span></li>
      </ul>
      <div class="game-shell">
        <div class="game-hud">
          <div class="shots" id="shots"></div>
          <div class="score"><span id="goals">0</span><small>buts</small></div>
          <div class="best"><span class="lvl-badge" id="pLvlBadge">Normal</span> Record <b id="best">0</b><span>/5</span></div>
        </div>
        <div class="game-wrap" id="gameWrap">
          <canvas id="game" role="img" aria-label="Mini-jeu de tirs au but face au gardien du Thier"></canvas>
          <div class="game-overlay" id="overlay">
            <img src="/images/crest.svg" alt="" class="ov-crest" width="72" height="84" loading="lazy" decoding="async" />
            <p class="ov-title" id="ovTitle">À vous de tirer</p>
            <p class="ov-sub" id="ovSub">5 tirs · visez et cliquez</p>
            <fieldset class="lvl-pick" id="pLevel">
              <legend>Niveau du gardien</legend>
              <label><input type="radio" name="plevel" value="facile" /><span>Facile<small>Gardien lent</small></span></label>
              <label><input type="radio" name="plevel" value="normal" defaultChecked /><span>Normal<small>Équilibré</small></span></label>
              <label><input type="radio" name="plevel" value="pro" /><span>Pro<small>Il lit vos tirs</small></span></label>
            </fieldset>
            <form class="pseudo" id="pForm" hidden>
              <label for="pName">Nouveau top 3 ! Votre pseudo :</label>
              <div><input id="pName" maxlength="12" autocomplete="off" placeholder="ex. Tom9" required /><button class="btn btn-yellow" type="submit">Enregistrer</button></div>
              <button type="button" class="skip" data-skip="p">Passer</button>
            </form>
            <button type="button" class="btn btn-yellow" id="startBtn">Commencer</button>
          </div>
        </div>
      </div>
    </div>

    <aside class="podium">
      <div class="podium-head">
        <p class="tag">Top 3</p>
        <h3 id="boardTitle">Runner</h3>
      </div>
      <ol class="pod-list" id="boardRunner"></ol>
      <ol class="pod-list" id="boardPenalty" hidden></ol>
      <p class="pod-goal" id="podGoal"></p>
      <p class="small">Scores enregistrés sur cet appareil.</p>
    </aside>
  </div>
</section>

