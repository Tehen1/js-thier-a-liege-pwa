---
// Navigation principale du club (extrait de ClubMarkup.tsx)
// Le bouton burger et le thème sont initialisés par /app.js au chargement.
---
<header class="nav" id="nav">
  <a href="#top" class="brand" aria-label="JS Thier à Liège, retour en haut">
    <img src="/images/crest.svg" alt="" class="brand-crest" width="46" height="54" decoding="async" />
    <span class="brand-txt">JS Thier<em>à Liège</em></span>
  </a>
  <nav class="links" id="links" aria-label="Navigation principale">
    <a href="#club">Le club</a>
    <a href="#equipes">Équipes</a>
    <a href="#inscriptions">Inscriptions</a>
    <a href="#terrain">Terrain</a>
    <a href="#jeu">Jeux</a>
    <a href="#contact" class="cta-sm">Contact</a>
  </nav>
  <button class="icon-btn theme-btn" id="themeBtn" type="button" aria-label="Passer au thème sombre">
    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  </button>
  <button class="icon-btn burger" id="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="links"><span></span><span></span></button>
</header>
